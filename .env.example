# Tricount Integration — completely optional.
# Without these variables, the application relies on plain text export, which is
# the reliable approach. The automatic relay option won't even appear in the UI.

# Enables the Tricount integration module on the client (settings and results screen).
VITE_TRICOUNT_ENABLED=false

# Default relay address baked into the build — can be overridden in the app settings.
# Defaults to /api/tricount, which applies when the relay is hosted on the same origin.
# VITE_TRICOUNT_RELAY_URL=https://relay.example.com/api/tricount

# The relay authentication token should NOT be placed here: a PWA build is a public
# asset, and anything placed here is readable in the bundle. The token is entered in the
# app settings and stored locally on the device, just like the Gemini API key.
