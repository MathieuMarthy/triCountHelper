# Intégration Tricount (§9) — entièrement facultative.
# Sans ces variables, l'application se contente de l'export texte, qui est
# la voie fiable. L'envoi automatique n'apparaît même pas dans l'interface.

# Active le module côté client (bouton dans les réglages et sur les résultats).
VITE_TRICOUNT_ENABLED=false

# Adresse du relais livrée par le build — un simple défaut, que le champ
# « Adresse du relais » des réglages remplace sur chaque appareil. Par défaut
# /api/tricount, ce qui ne vaut que pour un relais servi sur la même origine.
# VITE_TRICOUNT_RELAY_URL=https://relais.exemple.net/api/tricount

# Le jeton d'authentification du relais ne se met PAS ici : un build de PWA est
# un fichier public, tout ce qu'il contient est lisible. Il se saisit dans les
# réglages et reste sur l'appareil, comme la clé Gemini.
